name: Reusable Apigee CI/CD (K8s Runner)

on:
  workflow_call:
    inputs:
      apigee_org:
        required: true
        type: string
      apigee_env:
        required: true
        type: string
      deploy_proxy:
        required: true
        type: string
      node_version:
        required: false
        default: '18'
        type: string
    secrets:
      APIGEE_TOKEN:
        required: true
      SONAR_TOKEN:
        required: true

jobs:
  get-token:
    runs-on: [self-hosted, kubernetes, org-runner]
    permissions:
      contents: 'read'
      id-token: 'write'
    outputs:
      registry_token: ${{ steps.auth.outputs.access_token }}
    steps:
      - uses: actions/checkout@v4
      - id: auth
        uses: google-github-actions/auth@v2
        with:
          # Use the Service Account linked via Workload Identity earlier
          service_account: 'gh-runner-gsa@methodical-mark-482504-j3.iam.gserviceaccount.com'
          token_format: 'access_token'
          workload_identity_provider: 'projects/1076618220242/locations/global/workloadIdentityPools/forgecrux-pool/providers/github-provider'
  
  build-lint-deploy:
    needs: get-token
    runs-on: [self-hosted, kubernetes, org-runner]

    # 🔥 Job-level container (pulled from Artifact Registry)
    container:
      image: us-central1-docker.pkg.dev/methodical-mark-482504-j3/ps-apigee-ci/apigee-ci:2.0.1

    steps:
      # 1️⃣ Authenticate Docker to Artifact Registry
      - name: Configure Docker for GAR
        run: |
          gcloud auth configure-docker us-central1-docker.pkg.dev --quiet

      # 2️⃣ Checkout source
      - name: Checkout repository
        uses: actions/checkout@v4

      # 3️⃣ Setup Node.js
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: ${{ inputs.node_version }}

      # 4️⃣ Install linting tools
      - name: Install linting tools
        run: |
          npm install -g apigeelint eslint sonarqube-scanner

      # 5️⃣ Apigee lint
      - name: Run Apigee Lint
        run: |
          apigeelint -s apiproxy -f table.js

      # 6️⃣ JS lint
      - name: Run JavaScript Lint
        run: |
          eslint apiproxy/resources/jsc --ext .js

      # 7️⃣ Sonar scan
      - name: Sonar Scan
        run: |
          sonar-scanner \
            -Dsonar.projectKey=${{ github.repository }} \
            -Dsonar.sources=apiproxy
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}

      # 8️⃣ Package proxy
      - name: Package Apigee Proxy
        run: |
          zip -r proxy.zip apiproxy

      # 9️⃣ Import proxy
      - name: Import API Proxy
        run: |
          curl -X POST \
            -H "Authorization: Bearer ${{ secrets.APIGEE_TOKEN }}" \
            -H "Content-Type: multipart/form-data" \
            -F file=@proxy.zip \
            "https://apigee.googleapis.com/v1/organizations/${{ inputs.apigee_org }}/apis?action=import&name=${{ inputs.deploy_proxy }}"

      # 🔟 Deploy proxy
      - name: Deploy API Proxy
        run: |
          curl -X POST \
            -H "Authorization: Bearer ${{ secrets.APIGEE_TOKEN }}" \
            "https://apigee.googleapis.com/v1/organizations/${{ inputs.apigee_org }}/environments/${{ inputs.apigee_env }}/apis/${{ inputs.deploy_proxy }}/revisions/1/deployments"
